# Reference only: export these variables in your shell. This file is not auto-loaded.
AEGIS_RUNTIME=runtime
AEGIS_POLL_SECONDS=10
AEGIS_DEMO=true
AEGIS_SECURE_COOKIE=false
AEGIS_EMBEDDED_AGENT=true
# run.sh overrides this to false for the API and starts an independent agent.
# Leave the bootstrap password unset to generate private random account passwords.
# Use HTTPS and secure cookies if you later place the sandbox behind a reverse proxy.
# Real Phorge integration is optional during local development.
PHORGE_URL=
PHORGE_TOKEN=
PHORGE_PROJECT_PHID=
PHORGE_OWNER_PHID=
PHORGE_PRIORITY=high
